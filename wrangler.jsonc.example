// Copy to wrangler.jsonc and fill in the placeholders. wrangler.jsonc is
// gitignored: it carries your database id, hostname and Access tag.
{
  "name": "health-monitor",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "healthmon",
      "database_id": "PASTE_THE_ID_FROM_WRANGLER_D1_CREATE"
    }
  ],
  // Twice a day in UTC. These two land at about 8 AM and 7 PM in US Eastern
  // time, outside the default 22:00 to 08:00 quiet hours, so an alert found by
  // a run is delivered by that run. Shift them for your own timezone.
  "triggers": {
    "crons": ["0 12 * * *", "0 23 * * *"]
  },
  "routes": [
    { "pattern": "health.example.com", "custom_domain": true }
  ],
  // The only way in is the custom domain behind Cloudflare Access. A
  // workers.dev or preview URL would be a second door around Access.
  "workers_dev": false,
  "preview_urls": false,
  "rules": [
    { "type": "Text", "globs": ["**/*.html"], "fallthrough": true }
  ],
  "vars": {
    // Your IANA timezone. Local dates, quiet hours and the nightly wake date use it.
    "TZ": "America/New_York",
    // The one Google account Access lets in. The Worker checks it again.
    "ALLOWED_EMAIL": "you@example.com",
    // From Zero Trust. Not secrets: the team domain is public and the AUD tag
    // only identifies the Access application. Until both are set every data
    // route answers 503.
    "ACCESS_TEAM_DOMAIN": "https://<team>.cloudflareaccess.com",
    "ACCESS_AUD": "PASTE_THE_APPLICATION_AUDIENCE_TAG"
  },
  "observability": { "enabled": true }
}
